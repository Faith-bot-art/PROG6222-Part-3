@model IEnumerable<RaceDay.MVC.Models.EnrolmentDto>

@{
    ViewData["Title"] = "My Enrolments";
}

<h2 class="mt-4">My Enrolments</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">You haven't enrolled in any events yet. <a asp-controller="Home" asp-action="Index">Browse events here.</a></div>
}
else
{
    <table class="table table-striped table-hover mt-3">
        <thead class="table-dark">
            <tr>
                <th>Event</th>
                <th>Date</th>
                <th>Category</th>
                <th>Bib Number</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.EventName</td>
                    <td>@item.EventStartDate.ToString("dd MMM yyyy")</td>
                    <td>@item.CategoryName</td>
                    <td>@(item.BibNumber?.ToString() ?? "Pending")</td>
                    <td>
                        @if (item.Status == "Confirmed")
                        {
                            <span class="badge bg-success">Confirmed</span>
                        }
                        else if (item.Status == "Registered")
                        {

                            <span class="badge bg-warning text-dark">Registered</span>
                        }
                        else
                        {

                            <span class="badge bg-danger">@item.Status</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}