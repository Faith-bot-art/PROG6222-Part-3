@model RaceDay.MVC.Models.EventDto

@{
    ViewData["Title"] = Model.Name;
    var categories = ViewBag.Categories as List<RaceDay.MVC.Models.CategoryDto>;
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8">
            <h1 class="display-5 fw-bold">@Model.Name</h1>
            <h4 class="text-muted">@Model.StartDate.ToString("dddd, dd MMMM yyyy")</h4>
            <hr />
            <p class="lead">@Model.Description</p>

            <ul class="list-group mb-4">
                <li class="list-group-item"><strong>Location:</strong> @Model.Location</li>
                <li class="list-group-item"><strong>Distance:</strong> @Model.DistanceKm km</li>
                <li class="list-group-item"><strong>Event Type:</strong> @Model.EventType</li>
                <li class="list-group-item"><strong>Organiser:</strong> @Model.OrganiserName</li>
            </ul>
        </div>

        <div class="col-md-4">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">Available Categories</h4>
                </div>
                <div class="card-body">
                    @if (categories != null && categories.Any())
                    {
                        @foreach (var cat in categories)
                        {
                            <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                                <div>
                                    <h5 class="mb-0">@cat.Name</h5>
                                    <small class="text-muted">R @cat.EntryFee</small>
                                </div>
                                <form asp-controller="Participant" asp-action="Enrol" method="post">
                                    <input type="hidden" name="eventId" value="@Model.EventId" />
                                    <input type="hidden" name="categoryId" value="@cat.CategoryId" />
                                    <button type="submit" class="btn btn-primary btn-sm">Enrol</button>
                                </form>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-danger">No categories available for this event yet.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>